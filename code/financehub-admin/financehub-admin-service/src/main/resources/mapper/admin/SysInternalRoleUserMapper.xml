<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.admin.mapper.SysInternalRoleUserMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.admin.entity.SysInternalRoleUserEntity">
                    <id column="id" property="id" />
                    <result column="role_id" property="roleId" />
                    <result column="sys_user_id" property="sysUserId" />
                    <result column="status" property="status" />
                    <result column="del_flag" property="delFlag" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, role_id, sys_user_id, status, del_flag, create_by, create_time, update_by, update_time
        </sql>
    <select id="selectPageByCondition"
            resultType="com.utfinancing.financehub.admin.model.vo.SysInternalRoleUserVO">
        select
        x.user_name,
        x.user_code,
        sir.role_name,
        siru.*
        from
        sys_internal_role_user siru
        inner join sys_internal_user x on
        x.id = siru.sys_user_id
        left join sys_internal_role sir on
        siru.role_id = sir.id
        where
        1 = 1
        and x.del_flag = '0'
        and siru.del_flag = '0'
        and sir.del_flag = '0'
        <if test="condition.roleId !=null">
            and siru.role_id = #{condition.roleId}
        </if>
        <if test="condition.sysUserId !=null">
            and x.id = #{condition.sysUserId}
        </if>
        <if test="condition.userName !=null and condition.userName !=''">
            and x.user_name like concat('%',#{condition.userName}::text,'%')
        </if>
        <if test="condition.status !=null and condition.status !=''">
            and siru.status = #{condition.status}
        </if>
        order by x.create_time desc
    </select>
</mapper>

