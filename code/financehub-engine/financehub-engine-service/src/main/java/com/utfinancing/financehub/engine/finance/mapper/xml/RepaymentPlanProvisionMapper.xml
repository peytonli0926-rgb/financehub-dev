        <update id="updateProvisionData">
            update eg_repayment_plan a
            inner join eg_repayment_plan_provision b on a.id = b.id
            set a.accrued = b.accrued,
                a.exception_type = b.exception_type,
                a.observed = b.observed,
                a.observed_expiration_date = b.observed_expiration_date,
                a.amortized = b.amortized,
                a.on_and_off_balance_sheet = b.on_and_off_balance_sheet,
                a.overdue_days = b.overdue_days
        </update>


        <update id="updateProvisionDataByOrgIds" parameterType="java.util.List">
            update eg_repayment_plan a
            inner join eg_repayment_plan_provision b on a.id = b.id
            set a.accrued = b.accrued,
                a.exception_type = b.exception_type,
                a.observed = b.observed,
                a.observed_expiration_date = b.observed_expiration_date,
                a.amortized = b.amortized,
                a.on_and_off_balance_sheet = b.on_and_off_balance_sheet,
                a.overdue_days = b.overdue_days
            where a.org_id in
            <foreach collection="orgIds" index="key" item="orgId" open="(" separator="," close=")">
                #{orgId}
            </foreach>
        </update>

