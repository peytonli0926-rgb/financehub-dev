    <insert id="insertContractBalanceLatest">
        insert into eg_contract_balance_latest<foreach item="column" collection="columns" separator="," open="(" close=")" index="">${column}</foreach>
        values<foreach item="value" collection="values" separator="," open="(" close=")" index="">#{value}</foreach>
    </insert>
    <select id="listReceivableRentBalanceByContractCodes"
            resultType="com.utfinancing.financehub.engine.finance.entity.ContractBalanceLatestEntity">
        select contract_code,client_code,org_id,system_code,business_code,
               (coalesce(lease_principal_receivable_balance, 0)
                + coalesce(lease_interest_receivable_balance, 0)
                + coalesce(lease_interest_vat_receivable_balance, 0)
                + coalesce(residual_value_receivable_balance, 0)
                + coalesce(residual_value_vat_receivable_balance, 0)) as receivable_rent_balance
        from eg_contract_balance_latest
        where 1=1
        <if test="contractCodeList != null and contractCodeList.size > 0">
            and contract_code in
            <foreach item="item" index="index" collection="contractCodeList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>
    <select id="listReceivableRentBalanceByContractCodeAndOrgId"
            resultType="com.utfinancing.financehub.engine.finance.entity.ContractBalanceLatestEntity">
        select contract_code,client_code,org_id,system_code,business_code,
               (coalesce(lease_principal_receivable_balance, 0)
                + coalesce(lease_interest_receivable_balance, 0)
                + coalesce(lease_interest_vat_receivable_balance, 0)
                + coalesce(residual_value_receivable_balance, 0)
                + coalesce(residual_value_vat_receivable_balance, 0)) as receivable_rent_balance
        from eg_contract_balance_latest
        where del_flag = '0'
        <if test="contractCodeList != null and contractCodeList.size > 0">
            and contract_code in
            <foreach item="item" index="index" collection="contractCodeList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="orgIdList != null and orgIdList.size > 0">
            and org_id in
            <foreach item="item" index="index" collection="orgIdList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>

    <insert id="updateContractBalance">
        update eg_contract_balance_latest set<foreach collection="paramMap" index="key" item="value" separator=",">${key} = #{value}</foreach>
        where id = #{id}
    </insert>

