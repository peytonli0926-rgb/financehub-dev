        </sql>
    <select id="selectByCondition"
            resultType="com.utfinancing.financehub.engine.claim.model.vo.ClaimOrderDetailVO">
        select
            x.*
        from
            financialdb.eg_claim_order_detail x
                inner join financialdb.financialdb.eg_claim_order eco on
                x.claim_order_id = eco.id
        where
            1 = 1
          and x.del_flag = '0'
          and eco.del_flag = '0'
        <if test="condition.expenseTypeList != null and condition.expenseTypeList.size > 0">
            and x.expense_type in
            <foreach item="item" index="index" collection="condition.expenseTypeList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="condition.orderStatus!=null and condition.orderStatus!=''">
            and eco.order_status = #{condition.orderStatus}
        </if>
        <if test="condition.isGenerateVoucher!=null and condition.isGenerateVoucher!=''">
            and eco.is_generate_voucher = #{condition.isGenerateVoucher}
        </if>
        isGenerateVoucher
    </select>
