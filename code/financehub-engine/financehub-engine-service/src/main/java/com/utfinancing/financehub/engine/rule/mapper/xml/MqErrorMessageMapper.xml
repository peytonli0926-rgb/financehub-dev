                    <result column="status" property="status" />
                    <result column="original_routing_key" property="originalRoutingKey" />
                    <result column="original_exchange" property="originalExchange" />
                    <result column="exception_message" property="exceptionMessage" />
                    <result column="exception_stacktrace" property="exceptionStacktrace" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
                    <result column="del_flag" property="delFlag" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, message_body, status, original_routing_key, original_exchange, exception_message, exception_stacktrace, create_by, create_time, update_by, update_time, del_flag
        </sql>
</mapper>

