    <select id="selectContractHisInfo"
            resultType="com.utfinancing.financehub.engine.finance.entity.ContractHisEntity">
        select a.*
        from eg_contract_his a,
        (
        select contract_code,org_id , max(id) id
        from eg_contract_his
        where
        del_flag = '0'
        group by contract_code,org_id
        ) b
        where a.id = b.id
        <if test="param.contractCode != null and param.contractCode != ''">
            and a.contract_code like concat('%', #{param.contractCode}::text, '%')
        </if>
        <if test="param.id != null ">
            and a.id = #{param.id}
        </if>
        <if test="param.contractCodeList != null and param.contractCodeList.size > 0">
            and a.contract_code in
            <foreach item="item" index="index" collection="param.contractCodeList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="param.clientName != null and param.clientName != ''">
            and a.client_name like concat('%', #{param.clientName}::text, '%')
        </if>
        <if test="param.currencyType != null and param.currencyType != ''">
            and a.currency_type = #{param.currencyType}::text
        </if>
        <if test="param.orgIdList != null and param.orgIdList.size > 0">
            and a.org_id in
            <foreach item="item" index="index" collection="param.orgIdList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="param.idList != null and param.idList.size > 0">
            and a.id in
            <foreach item="item" index="index" collection="param.idList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="param.processStatusList != null and param.processStatusList.size > 0">
            and a.process_status in
            <foreach item="item" index="index" collection="param.processStatusList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="param.notContainProcessStatus != null and param.notContainProcessStatus != ''">
            and a.process_status != #{param.notContainProcessStatus}::text
        </if>
        order by a.id desc
    </select>
