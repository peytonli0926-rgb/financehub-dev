<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.engine.finance.mapper.RecyclingEquipmentInMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.engine.finance.entity.RecyclingEquipmentInEntity">
                    <id column="id" property="id" />
                    <result column="inbound_date" property="inboundDate" />
                    <result column="org_id" property="orgId" />
                    <result column="financial_exposure" property="financialExposure" />
                    <result column="recycling_equipment_cost" property="recyclingEquipmentCost" />
                    <result column="provision_for_impairment" property="provisionForImpairment" />
                    <result column="process_status" property="processStatus" />
                    <result column="is_generate_voucher" property="isGenerateVoucher" />
                    <result column="del_flag" property="delFlag" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
                    <result column="batch_number" property="batchNumber" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, inbound_date, org_id, financial_exposure, recycling_equipment_cost, provision_for_impairment, process_status, is_generate_voucher, del_flag, create_by, create_time, update_by, update_time, batch_number
        </sql>

        <select id="getLastImportedRecyclingEquipmentByYearMonth" resultMap="BaseResultMap">
            select
            <include refid="Base_Column_List" />
            from
            eg_recycling_equipment_in t
            where
            t.del_flag = '0'
            and (t.inbound_date is not null and LEFT(t.inbound_date , 7) = #{inboundDateYearMonth})
            order by t.batch_number desc,t.create_time desc
            limit 1
        </select>

</mapper>

