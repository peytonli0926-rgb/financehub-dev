<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.engine.finance.mapper.AccountBalanceMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.engine.finance.entity.AccountBalanceEntity">
                    <id column="id" property="id" />
                    <result column="scene_code" property="sceneCode" />
                    <result column="scene_name" property="sceneName" />
                    <result column="account_code" property="accountCode" />
                    <result column="account_name" property="accountName" />
                    <result column="sign_company" property="signCompany" />
                    <result column="client_code" property="clientCode" />
                    <result column="client_name" property="clientName" />
                    <result column="contract_code" property="contractCode" />
                    <result column="contract_name" property="contractName" />
                    <result column="finance_date" property="financeDate" />
                    <result column="account_period" property="accountPeriod" />
                    <result column="debit_amount" property="debitAmount" />
                    <result column="credit_amount" property="creditAmount" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
                    <result column="del_flag" property="delFlag" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, scene_code, scene_name, account_code, account_name, sign_company, client_code, client_name, contract_code, contract_name, finance_date, account_period, debit_amount, credit_amount, create_by, create_time, update_by, update_time, del_flag
        </sql>
    <select id="selectAccountBefore"
            resultType="com.utfinancing.financehub.engine.finance.model.vo.AccountBalanceVO">
        select c.org_id,a.*
        from eg_account_balance a,
        (
        select contract_code, max(finance_date) finance_date
        from eg_account_balance
        where
        del_flag = '0'
        and contract_code is not null
        and client_code is not null
        and finance_date &lt;= #{param.financeDate}
        <if test="param.accountCode != null and param.accountCode != ''">
            and account_code = #{param.accountCode}
        </if>
        <if test="param.orgIdList != null and param.orgIdList.size > 0">
            and org_id in
            <foreach item="item" index="index" collection="param.orgIdList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="param.orgIdListNotIn != null and param.orgIdListNotIn.size > 0">
            and org_id not in
            <foreach item="item" index="index" collection="param.orgIdListNotIn" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        group by contract_code
        ) b,
        eg_contract c
        where a.finance_date = b.finance_date
        and a.contract_code = b.contract_code
        and a.contract_code = c.contract_code
        <if test="param.accountCode != null and param.accountCode != ''">
            and account_code = #{param.accountCode}
        </if>
    </select>


</mapper>

