<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.engine.finance.mapper.FundSystemBalanceMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.engine.finance.entity.FundSystemBalanceEntity">
            <id column="id" property="id" />
            <result column="bank_no" property="bankNo" />
            <result column="receivable_bill_balance" property="receivableBillBalance" />
            <result column="receivable_bill_amount" property="receivableBillAmount" />
            <result column="voucher_id" property="voucherId" />
            <result column="order_id" property="orderId" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
            <result column="del_flag" property="delFlag" />
            <result column="voucher_date" property="voucherDate" />
            <result column="payable_bill_balance" property="payableBillBalance" />
            <result column="payable_bill_amount" property="payableBillAmount" />
            <result column="payable_account_balance" property="payableAccountBalance" />
            <result column="payable_account_amount" property="payableAccountAmount" />
            <result column="receivable_unconfirm_receipt_balance" property="receivableUnconfirmReceiptBalance" />
            <result column="receivable_unconfirm_receipt_amount" property="receivableUnconfirmReceiptAmount" />
            <result column="transaction_type" property="transactionType" />
        </resultMap>

    <sql id="Base_Column_List">
        id, bank_no, receivable_bill_balance, receivable_bill_amount, voucher_id, order_id, create_by, create_time, update_by, update_time, del_flag, voucher_date, payable_bill_balance, payable_bill_amount, payable_account_balance, payable_account_amount, receivable_unconfirm_receipt_balance, receivable_unconfirm_receipt_amount
    </sql>

    <insert id="insertFundSystemBalance">
        insert into eg_fund_system_balance <foreach item="column" collection="columns" separator="," open="(" close=")" index="">${column}</foreach>
        values<foreach item="value" collection="values" separator="," open="(" close=")" index="">#{value}</foreach>
    </insert>
</mapper>

