    <insert id="copyDataFromRepaymentPlan">
        INSERT INTO eg_repayment_plan_temp (
        <include refid="Base_Column_List_Temp"/>
        )
        SELECT
        <include refid="Base_Column_List_Temp"/>
        FROM eg_repayment_plan
        where del_flag = '0'
                and contract_code not in (select
                                            distinct contract_code
                                          from eg_repayment_plan
                                          where del_flag = '0'
                                                and accrued = '0'
                                                and plan_date_period = #{param.planDatePeriod})
            <if test="param.notGenerateOrgIds != null and param.notGenerateOrgIds.size > 0">
                and org_id not in
                <foreach item="item" index="index" collection="param.notGenerateOrgIds" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="param.orgIdList != null and param.orgIdList.size > 0">
                and org_id in
                <foreach item="item" index="index" collection="param.orgIdList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
    </insert>
