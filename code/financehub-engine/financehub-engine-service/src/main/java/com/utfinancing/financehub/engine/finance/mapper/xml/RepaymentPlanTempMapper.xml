    </delete>

    <select id="countContractCode" resultType="java.lang.Integer">
        select count(1) from (
        select contract_code, count(1) from eg_repayment_plan_temp group by contract_code) a
    </select>


    <select id="listByOffsetAndLimit"
            resultType="com.utfinancing.financehub.engine.finance.entity.RepaymentPlanEntity">
        select <include refid="Base_Column_List"/>
        from eg_repayment_plan_temp t1
        inner join (
        select contract_code
        from eg_repayment_plan_temp
        group by contract_code
        order by contract_code
        limit #{limit} offset #{offset}) t2 on t1.contract_code = t2.contract_code
        order by t1.contract_code , t1.plan_date
    </select>
