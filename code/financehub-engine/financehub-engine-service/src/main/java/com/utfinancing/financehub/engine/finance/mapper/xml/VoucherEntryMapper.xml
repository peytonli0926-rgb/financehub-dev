<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.engine.finance.mapper.VoucherEntryMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.engine.finance.entity.VoucherEntryEntity">
                    <id column="id" property="id" />
                    <result column="voucher_id" property="voucherId" />
                    <result column="fund_type" property="fundType" />
                    <result column="relate_bank_flag" property="relateBankFlag" />
                    <result column="bank_account" property="bankAccount" />
                    <result column="cash_attribute" property="cashAttribute" />
                    <result column="voucher_summary" property="voucherSummary" />
                    <result column="client_code" property="clientCode" />
                    <result column="contract_code" property="contractCode" />
                    <result column="account_code" property="accountCode" />
                    <result column="account_name" property="accountName" />
                    <result column="debit_credit_type" property="debitCreditType" />
                    <result column="account_period" property="accountPeriod" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
                    <result column="del_flag" property="delFlag" />
                    <result column="employee_code" property="employeeCode"/>
                    <result column="expense_type" property="expenseType"/>
                    <result column="financial_institution" property="financialInstitution"/>
                    <result column="cost_centre" property="costCentre"/>
                    <result column="receipt_number" property="receiptNumber"/>
                    <result column="derivative_contract_number" property="derivativeContractNumber"/>
                    <result column="batch_number" property="batchNumber"/>
                    <result column="eas_voucher_number" property="easVoucherNumber"/>
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, voucher_id, fund_type, relate_bank_flag, bank_account, cash_attribute, voucher_summary, voucherAmount, client_flag, client_code, client_name, contract_flag, contract_code, contract_name, account_code, account_name, debit_credit_type, account_period, create_by, create_time, update_by, update_time, del_flag, eas_voucher_number
        </sql>
    <select id="selectCourtCostByCondition"
            resultType="com.utfinancing.financehub.engine.finance.model.vo.VoucherEntryVO">
        select
        eve.*,
        x.order_id,
        x.batch_type
        from
        eg_voucher_entry eve
        inner join eg_voucher x on
        eve.voucher_id = x.id
        where
        1 = 1
        and x.del_flag = '0'
        and eve.del_flag = '0'
        and x.scene_code = 'SSF'
        and x.business_code = 'ZLYW'
        and x.system_code in ('MFXT','FINHUB')
        <if test="condition.contractCode!=null and condition.contractCode!=''">
            and x.contract_code = #{condition.contractCode}
        </if>
        <if test="condition.orgId!=null and condition.orgId!=''">
            and x.org_id = #{condition.orgId}
        </if>
        <if test="condition.voucherId!=null">
            and x.id = #{condition.voucherId}
        </if>
    </select>
</mapper>

