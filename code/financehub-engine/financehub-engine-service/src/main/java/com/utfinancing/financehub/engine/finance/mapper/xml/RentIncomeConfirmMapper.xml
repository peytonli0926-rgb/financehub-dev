<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.engine.finance.mapper.RentIncomeConfirmMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.engine.finance.entity.RentIncomeConfirmEntity">
                    <id column="id" property="id" />
                    <result column="contract_code" property="contractCode" />
                    <result column="client_code" property="clientCode" />
                    <result column="client_name" property="clientName" />
                    <result column="account_month" property="accountMonth" />
                    <result column="this_month_receivable_rent" property="thisMonthReceivableRent" />
                    <result column="this_month_tax" property="thisMonthTax" />
                    <result column="this_month_rent_income" property="thisMonthRentIncome" />
                    <result column="process_status" property="processStatus" />
                    <result column="process_instance_id" property="processInstanceId" />
                    <result column="voucher_id" property="voucherId" />
                    <result column="account_date" property="accountDate" />
                    <result column="error_info" property="errorInfo" />
                    <result column="del_flag" property="delFlag" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, contract_code, client_code, client_name, account_month, this_month_receivable_rent, this_month_tax, this_month_rent_income, process_status, process_instance_id, voucher_id, account_date, error_info, del_flag, create_by, create_time, update_by, update_time
        </sql>
    <select id="selectPreviousCarryOverAmount" resultType="java.math.BigDecimal">
        select receivable_rent_investment_property_amount
        from eg_contract_balance ecb
        where ecb.del_flag ='0'
        and ecb.scene_code ='DZZCJZ'
        and ecb.contract_code = #{contractCode}
        and ecb.client_code = #{clientCode}
        and ecb.org_id = #{orgId}
        order by id desc
        limit 1
    </select>
    <select id="selectCarryOverAmount" resultType="java.math.BigDecimal">
        select receivable_rent_investment_property_balance
        from eg_contract_balance_latest ecbl
        where ecbl.del_flag = '0'
        and ecbl.scene_code = 'DZZCJZ'
        and ecbl.contract_code = #{contractCode}
        and ecbl.client_code = #{clientCode}
        and ecbl.org_id = #{orgId}
        order by id desc
        limit 1
    </select>
</mapper>

