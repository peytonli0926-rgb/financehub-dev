    <select id="getProvision"
            resultType="com.utfinancing.financehub.engine.finance.model.vo.RecyclingEquipmentInDetailVO">
        select * from eg_recycling_equipment_in_detail ereid
        left join eg_recycling_equipment_in erei on erei.org_id =ereid.org_id
        and erei.inbound_date =ereid.inbound_date and erei.del_flag ='0' and ereid.recycle_id = erei.id
        where ereid.del_flag ='0'
        and ereid.contract_code = #{contractCode}
        and ereid.org_id = #{orgId}
        <if test="processStatusList != null and processStatusList.size > 0">
            and erei.process_status in
            <foreach item="item" index="index" collection="processStatusList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        order by ereid.id desc
        limit 1
    </select>
