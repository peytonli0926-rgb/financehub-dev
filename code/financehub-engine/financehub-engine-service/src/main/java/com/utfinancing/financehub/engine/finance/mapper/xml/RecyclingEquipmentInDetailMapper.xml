    <select id="getCheckData" resultType="com.utfinancing.financehub.engine.finance.model.vo.RecyclingEquipmentInCheckVO">
        select ereid.contract_code ,ereid.client_code,ereid.org_id
             ,tab_a.receivable_rent_balance+COALESCE(tab_b.receivable_rent_amount,0) as receivable_rent_balance
             ,tab_a.receivable_residual_value_balance+COALESCE(tab_b.receivable_residual_value_amount,0) as receivable_residual_value_balance
             ,tab_a.receivable_outtax_balance+COALESCE(tab_b.receivable_outtax_amount,0) as receivable_outtax_balance
             ,tab_a.unrealized_revenue_balance+COALESCE(tab_b.unrealized_revenue_amount,0) as unrealized_revenue_balance
             ,tab_a.lessee_margin_balance+COALESCE(tab_b.lessee_margin_amount,0) as lessee_margin_balance
        from
            eg_recycling_equipment_in_detail ereid
                left join
            (select ecbl.contract_code,ecbl.org_id , sum(ecbl.receivable_rent_balance) receivable_rent_balance, sum(ecbl.receivable_residual_value_balance) receivable_residual_value_balance,
                    sum(ecbl.receivable_outtax_balance) receivable_outtax_balance, sum(ecbl.unrealized_revenue_balance) unrealized_revenue_balance, sum(ecbl.lessee_margin_balance) lessee_margin_balance
             from eg_contract_balance_latest ecbl
             where exists (select 1 from eg_recycling_equipment_in_detail ereid where ereid.inbound_date = #{inboundDate} and ereid.org_id = #{orgId} and ecbl.contract_code=ereid.contract_code and ecbl.org_id=ereid.org_id )
             group by ecbl.contract_code ,ecbl.org_id) tab_a
            on ereid.contract_code = tab_a.contract_code and ereid.org_id = tab_a.org_id
                left join
            (select ecbt.contract_code,ecbt.org_id , sum(ecbt.receivable_rent_amount) receivable_rent_amount, sum(ecbt.receivable_residual_value_amount) receivable_residual_value_amount,
                    sum(ecbt.receivable_outtax_amount) receivable_outtax_amount, sum(ecbt.unrealized_revenue_amount) unrealized_revenue_amount, sum(ecbt.lessee_margin_amount) lessee_margin_amount
             from eg_contract_balance_temp ecbt
             where ecbt.scene_code  = 'CWRK'
               and to_char(ecbt.business_date , 'YYYY-MM-DD') = #{inboundDate} and ecbt.org_id =  #{orgId}
             group by ecbt.contract_code,ecbt.org_id) tab_b
            on tab_a.contract_code = tab_b.contract_code and tab_a.org_id = tab_b.org_id
        where ereid.inbound_date = #{inboundDate} and ereid.org_id = #{orgId} and ereid.del_flag ='0'
        <if test="recycleId!=null">
            and ereid.recycle_id = #{recycleId}
        </if>
    </select>
