<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.engine.scene.mapper.AccountMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.engine.scene.entity.AccountEntity">
                    <id column="id" property="id" />
                    <result column="business_code" property="businessCode" />
                    <result column="business_name" property="businessName" />
                    <result column="fund_type" property="fundType" />
                    <result column="account_code" property="accountCode" />
                    <result column="account_name" property="accountName" />
                    <result column="account_category" property="accountCategory" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
                    <result column="del_flag" property="delFlag" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, fund_type, account_code, account_name, account_category, create_by, create_time, update_by, update_time, del_flag
        </sql>
    <select id="getFundTypeString" resultType="java.lang.String">
        select string_agg(concat(ea.fund_type,'_','balance'),',') from eg_account ea where 1=1
        and ea.account_code in
        <foreach item="item" index="index" collection="accountCodeList" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>

