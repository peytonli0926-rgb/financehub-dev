<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.utfinancing.financehub.etl.financial.mapper.CheckCommonDataResultMapper">

        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.utfinancing.financehub.etl.financial.entity.CheckCommonDataResultEntity">
                    <id column="id" property="id" />
                    <result column="business_type" property="businessType" />
                    <result column="join_field" property="joinField" />
                    <result column="query_field" property="queryField" />
                    <result column="del_flag" property="delFlag" />
                    <result column="create_by" property="createBy" />
                    <result column="create_time" property="createTime" />
                    <result column="update_by" property="updateBy" />
                    <result column="update_time" property="updateTime" />
                    <result column="db_code" property="dbCode" />
                    <result column="show_field" property="showField" />
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            id, business_type, join_field, query_field, del_flag, create_by, create_time, update_by, update_time, db_code, show_field
        </sql>


        <delete id="clearTableData">
            delete from eg_check_common_data_result where to_char(execute_date, 'YYYYMMDD') = #{executeDateCode} and business_type = #{sqlMark} and period_code = #{periodCode}
        </delete>
</mapper>

