    <select id="selectAllAccountBank" resultType="com.utfinancing.financehub.etl.financial.model.dto.BankAccountDTO">
        SELECT
        t.FID AS eas_id,
        t.FNUMBER AS bank_account_code,
        t.FNAME_L2 AS bank_account_name,
        t.FBANKACCOUNTNUMBER AS bank_account_number,
        t.FISCLOSED AS close_flag,
        t.FCLOSEDATE AS close_date,
        org.FNUMBER AS org_id,
        b.FNAME_L2 AS bank_name ,
        acc.FNAME_L2 AS account_name,
        acc.FNUMBER AS account_code,
        cu.FISOCODE AS currency_code
        FROM HXORACLE.T_BD_ACCOUNTBANKS t
        JOIN HXORACLE.T_ORG_COMPANY org ON t.FCOMPANYID = org.FID
        LEFT JOIN HXORACLE.T_BD_BANK b ON t.FBANK = b.FID
        LEFT JOIN HXORACLE.T_BD_ACCOUNTVIEW acc ON t.FACCOUNTID = acc.FID
        LEFT JOIN HXORACLE.T_BD_CURRENCY cu ON t.FCURRENCYID = cu.FID
        WHERE 1=1 AND t.FISCLOSED='0'
    </select>


